# Copier ce fichier en ".env" puis adapter les valeurs. Ne jamais publier ".env".
# Pas de commentaire en fin de ligne (la ligne entière est lue comme valeur).
APP_ENV=production
APP_DEBUG=false
APP_URL=https://example.com
# Clé secrète pour les empreintes du journal d'audit. Générée par: php bin/create-admin.php (si vide)
APP_KEY=
APP_TIMEZONE=Africa/Algiers
APP_LOCALE=fr
LOG_LEVEL=info

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=

SESSION_IDLE_TIMEOUT=1800
SESSION_ABSOLUTE_TIMEOUT=28800

LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# Mettre à true uniquement derrière un proxy/CDN de confiance (ex. Cloudflare) qui envoie X-Forwarded-Proto
TRUST_PROXY_PROTO=false
