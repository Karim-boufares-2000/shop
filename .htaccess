Options -Indexes
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_URI} !(^|/)public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
<FilesMatch "^\.(env|git)">
    Require all denied
</FilesMatch>
<FilesMatch "\.(sql|log|bak|md|neon|xml|lock|json)$">
    Require all denied
</FilesMatch>
